<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="4dp" android:background="@drawable/wbg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
      <TextView android:id="@+id/w_surprise" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
          android:layout_margin="2dp" android:background="@drawable/wbtn" android:gravity="center"
          android:text="🎲\nSurprise" android:textColor="#FFE8EEFC" android:textSize="11sp" android:fontFamily="monospace" android:maxLines="2"/>
      <TextView android:id="@+id/w_storm" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
          android:layout_margin="2dp" android:background="@drawable/wbtn" android:gravity="center"
          android:text="⛈️\nStorm" android:textColor="#FFE8EEFC" android:textSize="11sp" android:fontFamily="monospace" android:maxLines="2"/>
      <TextView android:id="@+id/w_hurricane" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
          android:layout_margin="2dp" android:background="@drawable/wbtn" android:gravity="center"
          android:text="🌀\nHurricane" android:textColor="#FFE8EEFC" android:textSize="11sp" android:fontFamily="monospace" android:maxLines="2"/>
      <TextView android:id="@+id/w_tsunami" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
          android:layout_margin="2dp" android:background="@drawable/wbtn" android:gravity="center"
          android:text="🌊\nTsunami" android:textColor="#FFE8EEFC" android:textSize="11sp" android:fontFamily="monospace" android:maxLines="2"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
      <TextView android:id="@+id/w_volcano" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
          android:layout_margin="2dp" android:background="@drawable/wbtn" android:gravity="center"
          android:text="🌋\nVolcano" android:textColor="#FFE8EEFC" android:textSize="11sp" android:fontFamily="monospace" android:maxLines="2"/>
      <TextView android:id="@+id/w_nuke" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
          android:layout_margin="2dp" android:background="@drawable/wbtn" android:gravity="center"
          android:text="☢️\nNuke" android:textColor="#FFE8EEFC" android:textSize="11sp" android:fontFamily="monospace" android:maxLines="2"/>
      <TextView android:id="@+id/w_alien" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
          android:layout_margin="2dp" android:background="@drawable/wbtn" android:gravity="center"
          android:text="🛸\nAliens" android:textColor="#FFE8EEFC" android:textSize="11sp" android:fontFamily="monospace" android:maxLines="2"/>
      <TextView android:id="@+id/w_meteor" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
          android:layout_margin="2dp" android:background="@drawable/wbtn" android:gravity="center"
          android:text="☄️\nMeteor" android:textColor="#FFE8EEFC" android:textSize="11sp" android:fontFamily="monospace" android:maxLines="2"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
      <TextView android:id="@+id/w_blackhole" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
          android:layout_margin="2dp" android:background="@drawable/wbtn" android:gravity="center"
          android:text="⚫\nBlack hole" android:textColor="#FFE8EEFC" android:textSize="11sp" android:fontFamily="monospace" android:maxLines="2"/>
      <TextView android:id="@+id/w_party" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
          android:layout_margin="2dp" android:background="@drawable/wbtn" android:gravity="center"
          android:text="🎉\nParty" android:textColor="#FFE8EEFC" android:textSize="11sp" android:fontFamily="monospace" android:maxLines="2"/>
      <TextView android:id="@+id/w_glitch" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
          android:layout_margin="2dp" android:background="@drawable/wbtn" android:gravity="center"
          android:text="👾\nGlitch" android:textColor="#FFE8EEFC" android:textSize="11sp" android:fontFamily="monospace" android:maxLines="2"/>
      <TextView android:id="@+id/w_calm" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
          android:layout_margin="2dp" android:background="@drawable/wbtn" android:gravity="center"
          android:text="☀️\nCalm" android:textColor="#FFE8EEFC" android:textSize="11sp" android:fontFamily="monospace" android:maxLines="2"/>
    </LinearLayout>
</LinearLayout>
