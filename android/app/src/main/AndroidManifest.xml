<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-feature android:name="android.software.live_wallpaper" android:required="true"/>
  <application
      android:label="Tidal Chill"
      android:icon="@mipmap/ic_launcher"
      android:allowBackup="true"
      android:hardwareAccelerated="true"
      android:theme="@android:style/Theme.Material.NoActionBar">

    <activity android:name=".MainActivity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>

    <service
        android:name=".TideWallpaper"
        android:label="Tidal Chill"
        android:exported="true"
        android:permission="android.permission.BIND_WALLPAPER">
      <intent-filter><action android:name="android.service.wallpaper.WallpaperService"/></intent-filter>
      <meta-data android:name="android.service.wallpaper" android:resource="@xml/wallpaper"/>
    </service>

    <receiver android:name=".CmdReceiver" android:exported="false"/>

    <receiver android:name=".EventsWidget" android:label="Tidal events" android:exported="true">
      <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_events"/>
    </receiver>
    <receiver android:name=".SurpriseWidget" android:label="Tidal surprise" android:exported="true">
      <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_surprise"/>
    </receiver>
  </application>
</manifest>
